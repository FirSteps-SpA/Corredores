# Copia este archivo a .env.local y completa los valores. Nunca commitees .env.local.

# --- Supabase ---
# Local: `supabase status` (API URL y Publishable key; el stack de este repo usa el puerto 55321).
# Producción: Project Settings → API Keys del proyecto ioslqobvauapjpwhkgts.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Clave publishable (sb_publishable_…). La clave secreta NO va en la app ni en Netlify.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sitio ---
# Número de WhatsApp de la corredora, solo dígitos con código de país (ej. 569XXXXXXXX).
# Sin valor, la página no muestra el botón de WhatsApp.
NEXT_PUBLIC_WHATSAPP=

# --- Sentry (opcional) ---
# Sin DSN, Sentry no se inicializa.
NEXT_PUBLIC_SENTRY_DSN=
# Solo en el build de producción (Netlify), para subir source maps.
SENTRY_AUTH_TOKEN=
