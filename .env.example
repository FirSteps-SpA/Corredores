# Copia este archivo a .env.local y completa los valores. Nunca commitees .env.local.

# --- Supabase ---
# Local: `supabase status` (API URL y Publishable key; el stack de este repo usa el puerto 55321).
# Producción: Project Settings → API Keys del proyecto ioslqobvauapjpwhkgts.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Clave publishable (sb_publishable_…). La clave secreta NO va en la app ni en Netlify.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sitio ---
# Número de WhatsApp de la corredora, solo dígitos con código de país (ej. 569XXXXXXXX).
# Sin valor, el sitio no muestra botones de WhatsApp.
NEXT_PUBLIC_WHATSAPP=
# URL pública del sitio, sin barra final (enlace en el mensaje de WhatsApp). Por defecto
# https://gycmar.netlify.app; con dominio propio, el dominio.
NEXT_PUBLIC_SITE_URL=
# Opcionales: sin valor no se muestran.
NEXT_PUBLIC_CONTACTO_EMAIL=
# Usuario de Instagram (con o sin @) o la URL del perfil.
NEXT_PUBLIC_INSTAGRAM=

# --- UF (búsqueda por precio en UF y pesos; variables de servidor, no NEXT_PUBLIC_) ---
# El valor del día se pide a findic.cl. UF_RESPALDO se usa si findic.cl no responde y no hay un
# valor guardado; sin ninguno, el filtro de precio compara solo propiedades en la misma moneda.
UF_RESPALDO=
# "ninguna" desactiva la consulta a findic.cl (pruebas y CI, junto con UF_RESPALDO).
UF_FUENTE=

# --- Sentry (opcional) ---
# Sin DSN, Sentry no se inicializa. Solo envía eventos en builds de producción (`next build`).
NEXT_PUBLIC_SENTRY_DSN=
# "production" si se omite (Netlify). En local: local.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# Solo en el build de producción (Netlify), para subir source maps.
SENTRY_AUTH_TOKEN=
